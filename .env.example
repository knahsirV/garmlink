# Garmin credentials (used for initial auth and re-auth if tokens expire)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_password

# Base64-encoded garmin_tokens.json content (run: base64 < ~/.garminconnect/garmin_tokens.json)
GARMIN_TOKENS_JSON=

# GitHub OAuth App backing the claude.ai custom connector. Create one at
# https://github.com/settings/developers with callback URL
# <PUBLIC_BASE_URL>/auth/callback (e.g.
# https://garmlink-moz6szqd6q-uc.a.run.app/auth/callback).
# REQUIRED (unless ALLOW_UNAUTHENTICATED=1): the server refuses to start
# without it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to use the server. This is the only
# access control once OAuth is on, so it fails closed: a blank value, and a
# list that names nobody (e.g. ",,"), both abort startup.
# REQUIRED (unless ALLOW_UNAUTHENTICATED=1).
GITHUB_ALLOWED_USERS=

# The service's externally reachable URL (e.g.
# https://garmlink-moz6szqd6q-uc.a.run.app). OAuth callback URLs are derived
# from it. REQUIRED (unless ALLOW_UNAUTHENTICATED=1).
PUBLIC_BASE_URL=

# Secret guarding /readyz, checked independently of the OAuth flow so it still
# answers when OAuth itself is what's broken (generate: openssl rand -hex 32).
# REQUIRED (unless ALLOW_UNAUTHENTICATED=1).
READYZ_TOKEN=

# Set to 1 to run with NO authentication, skipping all five variables above
# (localhost development only).
# ALLOW_UNAUTHENTICATED=1

# --- Training plan document ------------------------------------------------
# The plan lives in a separate repo (content/plan.md, rendered by a GitHub Pages
# PWA) and is the source of truth for goals, race dates, the weekly template and
# zones. The coaching prompts read it at run time instead of hardcoding any of
# it. All four are optional; the defaults point at the real plan.
# TRAINING_PLAN_REPO=knahsirV/training-plan
# TRAINING_PLAN_PATH=content/plan.md
# TRAINING_PLAN_BRANCH=main

# Fine-grained PAT with Contents: read and write, scoped to the plan repo alone.
# Deliberately separate from GITHUB_CLIENT_ID/SECRET above: those authenticate
# users into this server and have no business holding repo write access.
# Without it the plan is still readable (public repo, 60 requests/hour) but
# update_training_plan refuses to write. The startup log line reports
# training_plan=readwrite when this is set, readonly when it is not.
TRAINING_PLAN_GITHUB_TOKEN=

# Port to listen on (Cloud Run sets this automatically)
PORT=8000

# Logging verbosity: DEBUG, INFO (default), WARNING, ERROR.
# LOG_LEVEL=INFO

# Log output format: "json" or "text". Defaults to json on Cloud Run (detected
# via K_SERVICE) so the platform parses `severity`, and to text elsewhere.
# LOG_FORMAT=text
